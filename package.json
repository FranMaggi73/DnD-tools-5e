{
  "name": "dnd-tools-spark",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "catalog:import": "node scripts/catalog/import.mjs",
    "catalog:refresh": "node scripts/catalog/import.mjs --refresh",
    "catalog:check": "node scripts/catalog/check.mjs",
    "catalog:audit": "node scripts/catalog/audit-duplicates.mjs",
    "catalog:audit-items": "node scripts/catalog/audit-items.mjs",
    "dev": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "test:rules": "firebase emulators:exec --project demo-dnd-spark --only firestore \"vitest run\"",
    "deploy": "firebase deploy --only firestore,hosting"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.14.1",
    "firebase-tools": "14.22.0",
    "vitest": "2.1.9"
  }
}
